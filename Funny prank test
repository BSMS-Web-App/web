<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Explosion Redirect</title>
    <style>
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            background-color: #111;
            color: white;
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        .instructions {
            text-align: center;
            z-index: 10;
        }

        kbd {
            background-color: #333;
            border: 1px solid #555;
            border-radius: 4px;
            padding: 4px 8px;
            font-family: monospace;
            font-size: 1.5rem;
            box-shadow: 0 2px 0 #000;
        }

        canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            display: none;
            z-index: 999;
        }
    </style>
</head>
<body>

    <div class="instructions">
        <h1>Press <kbd>F</kbd> to trigger the explosion</h1>
    </div>

    <canvas id="explosionCanvas"></canvas>

    <script>
        const canvas = document.getElementById('explosionCanvas');
        const ctx = canvas.getContext('2d');
        
        let animating = false;
        const redirectUrl = 'https://bsms-web.vercel.app';
        
        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        
        window.addEventListener('resize', resizeCanvas);

        // Listen for the 'F' key
        window.addEventListener('keydown', (e) => {
            if ((e.key === 'f' || e.key === 'F') && !animating) {
                triggerExplosion();
            }
        });

        function triggerExplosion() {
            animating = true;
            canvas.style.display = 'block';
            resizeCanvas();

            const centerX = canvas.width / 2;
            const centerY = canvas.height / 2;
            
            // Create particles
            const particles = [];
            const particleCount = 200;
            
            for (let i = 0; i < particleCount; i++) {
                const angle = Math.random() * Math.PI * 2;
                const speed = Math.random() * 15 + 2;
                particles.push({
                    x: centerX,
                    y: centerY,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed,
                    radius: Math.random() * 6 + 2,
                    color: ['#ff4500', '#ff8c00', '#ffd700', '#ff0000', '#ffffff'][Math.floor(Math.random() * 5)],
                    alpha: 1
                });
            }

            const startTime = performance.now();
            const duration = 3000; // 3 seconds

            function animate(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = elapsed / duration;

                // Clear screen with a fading flash effect in the first 200ms
                if (elapsed < 200) {
                    ctx.fillStyle = `rgba(255, 255, 255, ${1 - (elapsed/200)})`;
                    ctx.fillRect(0, 0, canvas.width, canvas.height);
                } else {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                }

                // Update and draw particles
                particles.forEach(p => {
                    p.x += p.vx;
                    p.y += p.vy;
                    p.vx *= 0.95; // Drag/slow down
                    p.vy *= 0.95;
                    
                    // Fade out over the 3 seconds
                    p.alpha = Math.max(0, 1 - progress);

                    ctx.save();
                    ctx.globalAlpha = p.alpha;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                    ctx.fillStyle = p.color;
                    ctx.shadowBlur = 15;
                    ctx.shadowColor = p.color;
                    ctx.fill();
                    ctx.restore();
                });

                if (elapsed < duration) {
                    requestAnimationFrame(animate);
                } else {
                    // Time's up, redirect
                    window.location.href = redirectUrl;
                }
            }

            requestAnimationFrame(animate);
        }
    </script>
</body>
</html>
