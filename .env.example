# BSMS Web dev2 application API (runs on the Mac mini).
APP_HOST=127.0.0.1
APP_PORT=4903
APP_ALLOWED_ORIGINS=https://bsms-web-dev2.vercel.app,http://localhost:3000

# The current dev2 application API connects to the production database API.
# Keep the production API key private in this server-side .env file.
BSMS_WEB_API_URL=http://127.0.0.1:4901
BSMS_WEB_API_KEY=replace-with-the-private-production-database-api-key

# Dev2 currently uses production media.
BSMS_WEB_PUBLIC_MEDIA_URL=https://media.bsms-web.com

# Optional: enables the OpenAI moderation provider in addition to Glin Profanity.
# OPENAI_API_KEY=replace-with-your-server-side-key
