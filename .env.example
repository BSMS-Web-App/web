# Server Configuration
PORT=3000

# Firebase Admin SDK — Service Account Credentials
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com

# Replace with a placeholder value; never commit a real private key.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PLACEHOLDER_KEY\n-----END PRIVATE KEY-----\n"

# Firebase Realtime Database
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Mac-hosted JSON database API (Vercel server-side only).
# Configure for Preview first. Do not add a NEXT_PUBLIC_ prefix or expose the key to browsers.
# Use the public HTTPS hostname routed to the Mac API through Cloudflare Tunnel.
BSMS_WEB_API_URL=https://replace-with-your-mac-api-hostname.example
BSMS_WEB_API_KEY=replace-with-a-random-secret-at-least-32-characters
