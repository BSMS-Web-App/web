# BSMS Web application server
PORT=3000

# Required Mac-hosted JSON database API (server-side only).
# Configure Preview first, then configure Production separately when ready.
# Never expose the key to browser code.
BSMS_WEB_API_URL=https://your-mac-api-hostname.example
BSMS_WEB_API_KEY=replace-with-a-random-secret-at-least-32-characters
