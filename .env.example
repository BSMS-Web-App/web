# BSMS Web Node.js / Express application API.
# Keep this file server-side. Never expose these values to browser code.
APP_HOST=127.0.0.1
APP_PORT=4903
APP_ALLOWED_ORIGINS=https://bsms-web.com

# URL of the Mac-hosted database API.
# Production uses the private server-to-server connection through the configured tunnel.
BSMS_WEB_API_URL=https://api.bsms-web.com
BSMS_WEB_API_KEY=replace-with-a-private-random-secret-at-least-32-characters

# Public media origin used when generating media URLs.
BSMS_WEB_PUBLIC_MEDIA_URL=https://media.bsms-web.com

# Optional: enables OpenAI Moderation in addition to the local Glin Profanity check.
# Text submitted for moderation is sent to OpenAI's Moderation API.
# OPENAI_API_KEY=replace-with-your-server-side-key

# Optional: required to enable voice calling through the self-hosted LiveKit server.
# Keep the key and secret identical to the private LiveKit service configuration.
# LIVEKIT_URL=wss://voice.bsms-web.com
# LIVEKIT_API_KEY=replace-with-your-livekit-api-key
# LIVEKIT_API_SECRET=replace-with-your-livekit-api-secret
