# BSMS Web dev2 application API (runs on the Mac mini).
APP_HOST=127.0.0.1
APP_PORT=4903
APP_ALLOWED_ORIGINS=https://bsms-web-dev2.vercel.app,http://localhost:3000

# Private dev2 database API (runs on the same Mac; do not expose this port publicly).
BSMS_WEB_API_URL=http://127.0.0.1:4902
BSMS_WEB_API_KEY=replace-with-the-same-random-secret-used-by-the-dev2-database-service
BSMS_WEB_PUBLIC_MEDIA_URL=https://media-dev2.bsms-web.com

# Optional: enables the OpenAI moderation provider in addition to Glin Profanity.
# OPENAI_API_KEY=replace-with-your-server-side-key
