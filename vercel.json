{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/account",
      "destination": "/accounts",
      "permanent": true
    },
    {
      "source": "/games",
      "destination": "/g",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/g/:gameSlug",
      "destination": "/game-player?slug=:gameSlug"
    },
    {
      "source": "/a-christmas-tale",
      "destination": "/frostfall"
    },
    {
      "source": "/event/a-christmas-tale",
      "destination": "/frostfall"
    }
  ],
  "git": {
    "deploymentEnabled": false
  },
  "$schema": "https://openapi.vercel.sh/vercel.json"
}
