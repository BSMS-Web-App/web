{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/account",
      "destination": "/accounts",
      "permanent": true
    },
    {
      "source": "/c",
      "destination": "/chat",
      "permanent": true
    },
    {
      "source": "/games",
      "destination": "/g",
      "permanent": true
    },
    {
      "source": "/rooms",
      "destination": "/chat",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/event/halloween-haunt",
      "destination": "/events",
      "permanent": true
    }
  ],
  "git": {
    "deploymentEnabled": false
  },
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/voice.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "admin/**",
      "use": "@vercel/static"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "img/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    },
    {
      "src": "metadata.json",
      "use": "@vercel/static"
    }
  ]
}
