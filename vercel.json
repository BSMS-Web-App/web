{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/account",
      "destination": "/accounts",
      "permanent": true
    },
    {
      "source": "/c",
      "destination": "/chat",
      "permanent": true
    },
    {
      "source": "/games",
      "destination": "/g",
      "permanent": true
    },
    {
      "source": "/rooms",
      "destination": "/chat",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/event/halloween-haunt",
      "destination": "/events",
      "permanent": true
    }
  ],
  "git": {
    "deploymentEnabled": false
  },
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/auth.js": {
      "includeFiles": "CHANGELOG.md"
    },
    "api/updates.js": {
      "includeFiles": "CHANGELOG.md"
    }
  }
}
