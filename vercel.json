{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/account",
      "destination": "/accounts",
      "permanent": true
    },
    {
      "source": "/games",
      "destination": "/g",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/g/:gameSlug",
      "destination": "/game-player.html?slug=:gameSlug"
    }
  ],
  "git": {
    "deploymentEnabled": false
  },
  "$schema": "https://openapi.vercel.sh/vercel.json"
}
