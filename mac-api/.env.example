# Optional isolated dev2 database API configuration.
# The active dev2 application API currently connects to production port 4901 instead.
# Keep the real .env private. Generate a separate dev2-only key with: openssl rand -hex 32
BSMS_WEB_API_KEY=replace-with-a-new-dev2-only-random-secret
BSMS_WEB_API_HOST=127.0.0.1
BSMS_WEB_API_PORT=4902
BSMS_WEB_DATA_FILE=/Users/REPLACE_WITH_MAC_USERNAME/BSMS-Web/dev2-data/db.json
BSMS_WEB_MEDIA_DIR=/Users/REPLACE_WITH_MAC_USERNAME/BSMS-Web/dev2-media
BSMS_WEB_PUBLIC_MEDIA_URL=https://dev-media.bsms-web.com

# Optional tuning
BSMS_WEB_API_BODY_LIMIT=25mb
BSMS_WEB_COMPACT_EVERY=1000
