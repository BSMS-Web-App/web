# BSMS Web production Mac database and media API.
# Generate a private key with: openssl rand -hex 32
# Keep the real .env private and never commit it.
BSMS_WEB_API_KEY=replace-with-a-generated-random-secret
BSMS_WEB_API_HOST=127.0.0.1
BSMS_WEB_API_PORT=4901
BSMS_WEB_DATA_FILE=/Users/REPLACE_WITH_MAC_USERNAME/BSMS-Web/data/db.json
BSMS_WEB_MEDIA_DIR=/Users/REPLACE_WITH_MAC_USERNAME/BSMS-Web/media
BSMS_WEB_PUBLIC_MEDIA_URL=https://media.bsms-web.com

# Optional tuning
BSMS_WEB_API_BODY_LIMIT=25mb
BSMS_WEB_COMPACT_EVERY=1000
