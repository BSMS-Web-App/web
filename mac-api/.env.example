# Private Mac API configuration. Keep this file out of Git.
# Generate the key with: openssl rand -hex 32
BSMS_API_KEY=replace-with-a-generated-random-secret
BSMS_API_HOST=127.0.0.1
BSMS_API_PORT=4902
BSMS_DATA_FILE=/Users/REPLACE_WITH_MAC_USERNAME/BSMS-Web-Data/db.json

# Optional tuning
BSMS_API_BODY_LIMIT=25mb
BSMS_COMPACT_EVERY=1000
